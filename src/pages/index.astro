---
// Homepage. Ported verbatim from the former Eleventy `index.njk`: 8 hardcoded
// sections (hero, trust strip, services, pricing, work, why, testimonial,
// final CTA). Inline SVGs are kept inline (they are not part of icons.ts).
// brandHref="#top" / home="" reproduce the original in-page anchor behavior;
// asset paths are root-absolute and service links use clean /services/<slug>/.
import Base from "../layouts/Base.astro";

const title = "thrtn85 Solutions: Technology, Branding & Support";
const description = "thrtn85 Solutions helps small businesses and nonprofits grow with technology, creative branding, and customer experience solutions that drive real results.";
---

<Base title={title} description={description} brandHref="#top" home="">

<!-- ============================ HERO ============================ -->
<section class="hero" id="about">
  <div class="container">
    <div class="hero-content">
      <p class="eyebrow eyebrow-accent">Technology · Branding · Support</p>
      <h1>Solutions That Help<br>Organizations <span class="hl">Thrive</span></h1>
      <p class="hero-sub">We help small businesses and nonprofits grow with technology, creative branding, and customer experience solutions that drive real results.</p>
      <div class="hero-actions">
        <a href="#consult" class="btn btn-primary">Get a Free Consultation
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#pricing" class="btn btn-ghost-light">View Pricing</a>
      </div>
      <div class="hero-badges">
        <span class="hero-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.4 2.4 4.6-4.8"/></svg>
          Small Business Focused
        </span>
        <span class="hero-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.4 2.4 4.6-4.8"/></svg>
          Nonprofit Friendly
        </span>
        <span class="hero-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.4 2.4 4.6-4.8"/></svg>
          U.S. Based Support
        </span>
      </div>
    </div>
  </div>
</section>

<!-- ============================ TRUST STRIP ============================ -->
<section class="logo-strip">
  <div class="container">
    <p class="eyebrow">Trusted by small businesses and nonprofits</p>
    <div class="logo-row">
      <span class="logo-item">
        <img src="/assets/images/bhp_logo.png" alt="Build Her Properties LLC" loading="lazy" />
      </span>
      <span class="logo-item">
        <img src="/assets/images/son_logo.webp" alt="Surviving Our Neighborhood Organization" loading="lazy" />
      </span>
      <span class="logo-item">
        <img src="/assets/images/portal_logo.avif" alt="Portal Entertainment Productions" loading="lazy" />
      </span>
      <span class="logo-item">
        <img src="/assets/images/ijt_logo.png" alt="IJT" loading="lazy" />
      </span>
    </div>
  </div>
</section>

<!-- ============================ SERVICES ============================ -->
<section class="section services" id="services">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow-accent">What We Do</p>
      <h2>Services That Move Your Organization <span class="hl">Forward</span></h2>
    </div>
    <div class="services-grid">

      <article class="svc-card">
        <div class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></div>
        <h3>Technology Services</h3>
        <p>Websites, IT support, business systems, and technology consulting.</p>
        <a href="/services/technology-services/" class="link-arrow">Learn More →</a>
      </article>

      <article class="svc-card">
        <div class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 19c-4 0-7-2.5-7-6 0-4 3-9 7-9s7 4 7 8c0 2.5-1.5 4-3.5 4S15 14 14 14c-1.2 0-2 .8-2 2 0 1.5-.5 3 0 3Z"/><circle cx="8.5" cy="10.5" r="1"/><circle cx="12" cy="8" r="1"/><circle cx="15.5" cy="10.5" r="1"/></svg></div>
        <h3>Creative &amp; Branding</h3>
        <p>Brand identity, logos, marketing materials, and creative strategy that connect.</p>
        <a href="/services/creative-branding/" class="link-arrow">Learn More →</a>
      </article>

      <article class="svc-card">
        <div class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v3a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 0ZM20 13v3a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 0Z"/><path d="M18 18v1a3 3 0 0 1-3 3h-3"/></svg></div>
        <h3>Customer Experience</h3>
        <p>Support systems, workflows, help centers, and customer journey improvements.</p>
        <a href="/services/customer-experience/" class="link-arrow">Learn More →</a>
      </article>

      <article class="svc-card">
        <div class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z"/><path d="m9.2 12 2 2 3.6-3.8"/></svg></div>
        <h3>Technology Assessments</h3>
        <p>Identify risks, inefficiencies, and opportunities to improve and grow.</p>
        <a href="/services/technology-assessments/" class="link-arrow">Learn More →</a>
      </article>

      <article class="svc-card">
        <div class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 18a4 4 0 0 1-.5-7.97A6 6 0 0 1 18 9a3.5 3.5 0 0 1-.5 9H7Z"/><path d="M12 16v-5M9.5 13 12 10.5 14.5 13"/></svg></div>
        <h3>Managed Support</h3>
        <p>Ongoing website maintenance, updates, security, and reliable support.</p>
        <a href="/services/managed-support/" class="link-arrow">Learn More →</a>
      </article>

      <article class="svc-card">
        <div class="svc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.4"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M15 19a4 4 0 0 1 6 0"/></svg></div>
        <h3>Strategic Partnerships</h3>
        <p>Access our network of trusted specialists for projects of any size or scope.</p>
        <a href="/services/strategic-partnerships/" class="link-arrow">Learn More →</a>
      </article>

    </div>
  </div>
</section>

<!-- ============================ PRICING ============================ -->
<section class="section pricing" id="pricing">
  <div class="container">
    <div class="section-head-row">
      <div>
        <p class="eyebrow eyebrow-accent is-left">Simple. Transparent. Affordable.</p>
        <h2>Pricing That Fits Your <span class="hl">Budget</span></h2>
      </div>
      <a href="#pricing" class="link-arrow">View All Pricing →</a>
    </div>

    <div class="pricing-grid">

      <article class="price-card featured">
        <span class="price-badge">Most Popular</span>
        <div class="price-head">
          <span class="price-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></span>
          <h3>Website Support</h3>
        </div>
        <div class="price-amount">
          <span class="from">Starting at</span>
          <span class="big">$99</span><span class="per"> /month</span>
        </div>
        <ul class="price-features">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Hosting management</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Security updates</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Backups</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Technical support</li>
        </ul>
        <a href="#consult" class="btn btn-primary btn-block">Learn More</a>
      </article>

      <article class="price-card">
        <div class="price-head">
          <span class="price-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21M12 3C9.5 5.5 8.2 8.7 8.2 12S9.5 18.5 12 21"/></svg></span>
          <h3>Business Website</h3>
        </div>
        <div class="price-amount">
          <span class="from">Starting at</span>
          <span class="big">$1,500</span>
        </div>
        <ul class="price-features">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Up to 5 pages</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Mobile friendly</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Contact forms</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> SEO basics</li>
        </ul>
        <a href="#consult" class="btn btn-outline btn-block">Learn More</a>
      </article>

      <article class="price-card">
        <div class="price-head">
          <span class="price-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M5 20a7 7 0 0 1 14 0"/></svg></span>
          <h3>IT Consulting</h3>
        </div>
        <div class="price-amount">
          <span class="from">Starting at</span>
          <span class="big">$125</span><span class="per"> /hr</span>
        </div>
        <ul class="price-features">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Technology assessments</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Process improvement</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Vendor recommendations</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 12 4 4 10-10"/></svg> Strategic guidance</li>
        </ul>
        <a href="#consult" class="btn btn-outline btn-block">Learn More</a>
      </article>

      <article class="price-card">
        <div class="price-head">
          <span class="price-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 13a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-1v-5h1M4 13v4a2 2 0 0 0 2 2h1v-5H6"/></svg></span>
          <h3>Managed Support</h3>
        </div>
        <div class="price-amount">
          <span class="custom">Custom Pricing</span>
        </div>
        <p class="price-blurb">Ongoing support tailored to your organization's needs.</p>
        <a href="#consult" class="btn btn-outline btn-block">Contact Us</a>
      </article>

    </div>

    <p class="pricing-note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.4 2.4 4.6-4.8"/></svg>
      Nonprofit discounts available. Let's talk about how we can help.
    </p>
  </div>
</section>

<!-- ============================ OUR WORK ============================ -->
<section class="section work" id="work">
  <div class="container">
    <div class="section-head-row">
      <div>
        <p class="eyebrow eyebrow-accent is-left">Our Work</p>
        <h2>Solutions. Results. <span class="hl">Impact.</span></h2>
      </div>
      <a href="#work" class="link-arrow">View More Projects →</a>
    </div>

    <div class="work-grid">
      <a href="#work" class="work-card">
        <div class="work-thumb"><div class="img-placeholder">Watch Her Hoop screenshot</div></div>
        <h3>Watch Her Hoop</h3>
        <p>Website Design &amp; Development</p>
      </a>
      <a href="#work" class="work-card">
        <div class="work-thumb"><div class="img-placeholder">API Vitals screenshot</div></div>
        <h3>API Vitals</h3>
        <p>Platform Development</p>
      </a>
      <a href="#work" class="work-card">
        <div class="work-thumb"><div class="img-placeholder">Kingdom Builders screenshot</div></div>
        <h3>Kingdom Builders</h3>
        <p>Website Design</p>
      </a>
      <a href="#work" class="work-card">
        <div class="work-thumb"><div class="img-placeholder">Youth Impact screenshot</div></div>
        <h3>Youth Impact</h3>
        <p>Branding &amp; Website Design</p>
      </a>
    </div>
  </div>
</section>

<!-- ============================ WHY CHOOSE US ============================ -->
<section class="section why">
  <div class="container">
    <p class="eyebrow eyebrow-accent is-left">Why Organizations Choose Us</p>
    <div class="why-grid">
      <div class="why-intro">
        <h2>Your Partner in <span class="hl">Growth</span></h2>
        <p>We combine technology, creativity, and practical solutions to help organizations thrive.</p>
        <a href="#consult" class="btn btn-primary">Let's Work Together
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="why-items">
        <div class="why-item">
          <div class="why-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9.5" r="2.4"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M15 19a4 4 0 0 1 6 0"/></svg></div>
          <h3>People First</h3>
          <p>We listen, collaborate, and care about your mission.</p>
        </div>
        <div class="why-item">
          <div class="why-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg></div>
          <h3>Fast &amp; Reliable</h3>
          <p>Responsive support when you need it most.</p>
        </div>
        <div class="why-item">
          <div class="why-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z"/><path d="m9.2 12 2 2 3.6-3.8"/></svg></div>
          <h3>Secure &amp; Trusted</h3>
          <p>Protecting your data and your organization.</p>
        </div>
        <div class="why-item">
          <div class="why-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></div>
          <h3>Results Driven</h3>
          <p>Solutions that create real, measurable impact.</p>
        </div>
        <div class="why-item">
          <div class="why-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m11 14 2 2 4-4M3 11l5-5 4 3 4-4 5 5-9 9-9-8Z"/></svg></div>
          <h3>Long Term Partner</h3>
          <p>We grow with you every step of the way.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ TESTIMONIAL ============================ -->
<section class="testi grid-bg">
  <div class="container">
    <div class="testi-inner">
      <span class="testi-quotemark" aria-hidden="true">&ldquo;</span>
      <div class="testi-row">
        <div class="testi-avatar" aria-hidden="true">EM</div>
        <div class="testi-body">
          <p class="testi-quote">thrtn85 Solutions has been a game changer for our organization. They are professional, responsive, and truly understand the needs of nonprofits.</p>
          <div class="testi-cite">
            <span class="name">Ebony McClenny</span>
            <span class="role">Executive Director, SON Organization</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================ FINAL CTA ============================ -->
<section class="final-cta grid-bg" id="consult">
  <div class="container">
    <div class="final-left">
      <p class="eyebrow eyebrow-accent is-left">Let's Get Started</p>
      <h2>Ready to Take the <span class="hl">Next Step?</span></h2>
      <p class="final-sub">Let's talk about your goals and build a plan that fits your organization and budget.</p>
    </div>
    <div class="final-feats">
      <div class="final-feat">
        <div class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg></div>
        <h4>Free Consultation</h4>
        <p>Get expert guidance at no cost.</p>
      </div>
      <div class="final-feat">
        <div class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg></div>
        <h4>Clear Plan</h4>
        <p>We'll outline the best solution for you.</p>
      </div>
      <div class="final-feat">
        <div class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></div>
        <h4>Real Results</h4>
        <p>Solutions that help you grow.</p>
      </div>
    </div>
    <a href="mailto:hello@thrtn85.com" class="btn btn-primary">Schedule Your Free Consultation
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>

</Base>
